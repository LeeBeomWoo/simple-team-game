{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/host",
      "destination": "/public/host.html"
    },
    {
      "source": "/guest",
      "destination": "/public/guest.html"
    },
    {
      "source": "/",
      "destination": "/public/host.html"
    }
  ]
}
